{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Availability SLO (target: 99.9%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.999 },
              { "color": "green", "value": 0.9995 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "candidate_api:availability:ratio5m",
          "legendFormat": "Availability"
        }
      ]
    },
    {
      "title": "Latency SLO (target: 95% < 500ms)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.9,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.95 },
              { "color": "green", "value": 0.98 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "candidate_api:latency_500ms:ratio5m",
          "legendFormat": "Latency"
        }
      ]
    },
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "candidate_api:http_requests:rate5m",
          "legendFormat": "Total req/s"
        },
        {
          "expr": "candidate_api:http_errors:rate5m",
          "legendFormat": "Errors (5xx) req/s"
        }
      ]
    },
    {
      "title": "Error Budget Remaining (30d window)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "clamp_min(1 - ((1 - candidate_api:availability:ratio5m) / 0.001), 0)",
          "legendFormat": "Availability Budget"
        }
      ]
    },
    {
      "title": "Availability Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0.99 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "candidate_api:availability:ratio5m",
          "legendFormat": "Availability (5m)"
        },
        {
          "expr": "candidate_api:availability:burnrate1h",
          "legendFormat": "Availability (1h)"
        },
        {
          "expr": "0.999",
          "legendFormat": "SLO Target (99.9%)"
        }
      ]
    },
    {
      "title": "Latency Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0.8 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "candidate_api:latency_500ms:ratio5m",
          "legendFormat": "< 500ms (5m)"
        },
        {
          "expr": "candidate_api:latency_500ms:burnrate1h",
          "legendFormat": "< 500ms (1h)"
        },
        {
          "expr": "0.95",
          "legendFormat": "SLO Target (95%)"
        }
      ]
    },
    {
      "title": "Request Duration Heatmap",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(http_request_duration_seconds_bucket{endpoint!~\"/metrics|/health/.*\"}[$__rate_interval])) by (le)",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s" }
      }
    },
    {
      "title": "Requests by Endpoint & Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (endpoint, code) (rate(http_requests_received_total{endpoint!~\"/metrics|/health/.*\"}[5m]))",
          "legendFormat": "{{endpoint}} [{{code}}]"
        }
      ]
    },
    {
      "title": "Pod CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"dev|test\",container=\"candidate-api\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "title": "Pod Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"dev|test\",container=\"candidate-api\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["candidate-api", "slo"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Candidate API — SLOs & Metrics",
  "uid": "candidate-api-slo",
  "version": 1
}
